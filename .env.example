# Copy to .env in the repository root. No credentials are needed in demo mode.
APP_ENV=development
AUTH_MODE=demo
# Optional browser-only preset schedule and mocked actions for UI development.
UI_DEMO=false
SOLVER_ENGINE=cp_sat
# Use demo_search only with data/demo_data.json for the initial scaffold demo.
SOLVER_TIME_LIMIT_SECONDS=8
DATABASE_PATH=./backend/nebulax.sqlite3
# All eight official CSVs are validated and imported atomically at startup.
OFFICIAL_DATA_PATH=./data
# Used only for explicit legacy seed/reset operations.
DATASET_PATH=./data/comprehensive_synthetic_data.json

# Optional: set AUTH_MODE=supabase and fill these values.
# Publishable key only. NEVER put a secret/service-role key here or in the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified Supabase user UUIDs, assigned by your team admin.
# Everyone else authenticated to this Supabase project is a requester.
OFFICER_USER_IDS=
